{
  "name": "@borodatych/security",
  "version": "0.1.2",
  "description": "Проверка защиты сервера: что открыто наружу и чем это закрыть",
  "type": "module",
  "main": "./dist/audit.js",
  "types": "./dist/types/audit.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/audit.d.ts",
      "default": "./dist/audit.js"
    },
    "./types": {
      "types": "./dist/types/types.d.ts"
    },
    "./i18n/ru": {
      "types": "./dist/types/i18n/ru.d.ts",
      "default": "./dist/i18n/ru.js"
    },
    "./recipes": {
      "types": "./dist/types/recipes/index.d.ts",
      "default": "./dist/recipes/index.js"
    }
  },
  "bin": {
    "borodatych-security": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "tsc --noEmit && eslint .",
    "test": "bun test",
    "stand": "bun run tests/stand/index.ts",
    "build": "bun build src/cli.ts --target node --outfile dist/cli.js && bun build src/audit.ts src/i18n/ru.ts src/recipes/index.ts --target node --root src --outdir dist && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/bun": "^1.2.0",
    "@types/node": "^20.19.0",
    "eslint": "^9.30.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.36.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borodatych/BorodatychSecurity.git"
  },
  "homepage": "https://github.com/borodatych/BorodatychSecurity#readme"
}
